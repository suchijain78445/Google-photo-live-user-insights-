# Recall — Photo Retrieval Discovery Engine
# Copy this file to .env and fill in your values

# Groq API (free tier - used for summarize.py and live Ask AI)
GROQ_API_KEY=your_api_key_here

# Optional: override the Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Anthropic API key (no longer required, kept for reference)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the data directory (default: Data reviews)
DATA_DIR=Data reviews

# Optional: override the output data directory (default: data)
OUTPUT_DIR=data
